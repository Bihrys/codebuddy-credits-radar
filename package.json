{
  "name": "codebuddy-usage",
  "displayName": "CodeBuddy Usage",
  "description": "在 VS Code 状态栏显示腾讯 CodeBuddy 积分/余量（自动拉取官网用量接口）",
  "publisher": "wwenc6621",
  "version": "0.4.0",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codebuddyUsage.refresh",
        "title": "CodeBuddy Usage: 刷新余量"
      },
      {
        "command": "codebuddyUsage.setCookie",
        "title": "CodeBuddy Usage: 设置登录 Cookie"
      },
      {
        "command": "codebuddyUsage.openUsagePage",
        "title": "CodeBuddy Usage: 打开官网用量页"
      },
      {
        "command": "codebuddyUsage.buddyClaim",
        "title": "CodeBuddy Usage: 喵喵领积分"
      },
      {
        "command": "codebuddyUsage.buddyDepart",
        "title": "CodeBuddy Usage: 喵喵去旅行"
      }
    ],
    "configuration": {
      "title": "CodeBuddy Usage",
      "properties": {
        "codebuddyUsage.cookie": {
          "type": "string",
          "default": "",
          "description": "从 workbuddy.cn 官网复制的登录 Cookie（仅存于本地）"
        },
        "codebuddyUsage.refreshIntervalMinutes": {
          "type": "number",
          "default": 30,
          "description": "自动刷新间隔（分钟），0 表示不自动刷新"
        },
        "codebuddyUsage.autoCheckin": {
          "type": "boolean",
          "default": true,
          "description": "启用自动每日签到领取积分（关闭后不执行签到，悬浮框不显示签到状态）"
        },
        "codebuddyUsage.apiBase": {
          "type": "string",
          "default": "https://www.workbuddy.cn",
          "description": "API 基地址（国内 .cn / 国际 .ai）"
        },
        "codebuddyUsage.buddyTravel": {
          "type": "boolean",
          "default": true,
          "description": "启用喵喵旅行（派喵喵出任务自动赚积分）。开启后每次刷新会自动领取并派出喵喵，悬浮框展示旅行倒计时/领积分/去旅行，一日一次"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
