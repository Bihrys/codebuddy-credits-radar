{
  "name": "codebuddy-usage",
  "displayName": "CodeBuddy Usage (社区版)",
  "description": "%extension.description%",
  "publisher": "bihrys",
  "version": "0.9.3",
  "icon": "resources/icon.png",
  "license": "MIT",
  "keywords": [
    "CodeBuddy",
    "WorkBuddy",
    "腾讯云代码助手",
    "credits",
    "积分",
    "余量",
    "usage",
    "statusbar"
  ],
  "galleryBanner": {
    "color": "#1e415e",
    "theme": "dark"
  },
  "repository": {
  	"type": "git",
  	"url": "https://github.com/Bihrys/codebuddy-usage-community.git"
  },
  "bugs": {
  	"url": "https://github.com/Bihrys/codebuddy-usage-community/issues"
  },
  "homepage": "https://github.com/Bihrys/codebuddy-usage-community#readme",
  "author": {
  	"name": "Bihrys",
  	"url": "https://github.com/Bihrys"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "codebuddyUsage.refresh",
        "title": "%command.refresh%"
      },
      {
        "command": "codebuddyUsage.setAccessToken",
        "title": "%command.setAccessToken%"
      },
      {
        "command": "codebuddyUsage.openUsagePage",
        "title": "%command.openUsagePage%"
      },
      {
        "command": "codebuddyUsage.buddyClaim",
        "title": "%command.buddyClaim%"
      },
      {
        "command": "codebuddyUsage.buddyDepart",
        "title": "%command.buddyDepart%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "codebuddyUsage.accessToken": {
          "type": "string",
          "default": "",
          "description": "%config.accessToken%"
        },
        "codebuddyUsage.userAgent": {
          "type": "string",
          "default": "",
          "description": "%config.userAgent%"
        },
        "codebuddyUsage.refreshIntervalMinutes": {
          "type": "number",
          "default": 30,
          "description": "%config.refreshIntervalMinutes%"
        },
        "codebuddyUsage.autoCheckin": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoCheckin%"
        },
        "codebuddyUsage.apiBase": {
          "type": "string",
          "default": "https://www.workbuddy.cn",
          "description": "%config.apiBase%"
        },
        "codebuddyUsage.buddyTravel": {
          "type": "boolean",
          "default": true,
          "description": "%config.buddyTravel%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
